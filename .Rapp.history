# Installer et charger le package epiR si ce n'est pas déjà fait#
# install.packages("epiR")#
library(epiR)#
#
# Définir le tableau 2x2#
# Format : matrix(c(a, b, c, d), nrow=2)#
# a = exposé et malade, b = exposé et non malade#
# c = non exposé et malade, d = non exposé et non malade#
tab <- matrix(c(30, 70, 10, 90), nrow = 2, byrow = TRUE)#
#
# Calcul du risque relatif (RR)#
result <- epi.2by2(tab, method = "cohort.count", conf.level = 0.95)#
#
# Affichage des résultats#
print(result)
