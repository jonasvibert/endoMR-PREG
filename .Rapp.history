############################################ endoMRPREG                              ## Jonas Vibert                            ## 19.04.25                                ############################################################################### 1. DATA PREPARATION - EXPOSURE #################################### Load packagesinstall.packages("remotes")remotes::install_github("MRCIEU/TwoSampleMR")remotes::install_github("MRCIEU/MRInstruments")install.packages("knitr")install.packages("ggplot2")install.packages("dplyr")install.packages("gwasrapidd")
library(TwoSampleMR)library(MRInstruments)library(knitr)library(ggplot2)library(dplyr)library(gwasrapidd)library(tidyr)
# === 1.0 EXTRACT FROM OPENGWASavailable_gwas <- gwasinfo()subset(available_gwas, grepl("Rahmioglu", author, ignore.case = TRUE))
